<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#8800FFC8"
                android:centerColor="#6600E5A0"
                android:endColor="#5500B37A"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#99FFFFFF"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:bottom="30dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="30dp"/>
        </shape>
    </item>
</layer-list>
